{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor",
    ":automergeDigest"
  ],
  "gitIgnoredAuthors": [
    "github-actions[bot]@users.noreply.github.com"
  ],
  "git-submodules": {
    "enabled": true
  },
  "minimumReleaseAge": "5 days",
  "stopUpdatingLabel": "take-a-break-renovate",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "No stability wait for internal openmcp-project packages",
      "matchSourceUrls": [
        "https://github.com/openmcp-project/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "No stability wait for internal openmcp-project docker images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackagePrefixes": [
        "ghcr.io/openmcp-project"
      ],
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group openmcp-project/build submodule and workflow updates",
      "matchDepNames": [
        "hack/common",
        "openmcp-project/build"
      ],
      "groupName": "openmcp-project/build",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group all openmcp-project Go dependencies into one PR",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/openmcp-project//"
      ],
      "groupName": "openmcp-project Go dependencies",
      "groupSlug": "openmcp-go-deps",
      "minimumReleaseAge": "0 days"
    }
  ]
}
