{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "security:openssf-scorecard",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlerts"
  ],
  "gitIgnoredAuthors": [
    "github-actions[bot]@users.noreply.github.com"
  ],
  "git-submodules": {
    "enabled": true
  },
  "minimumReleaseAge": "5 days",
  "stopUpdatingLabel": "take-a-break-renovate",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "rebaseWhen": "auto",
  "packageRules": [
    {
      "description": "No stability wait for internal openmcp-project packages",
      "matchSourceUrls": [
        "https://github.com/openmcp-project/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Renovate supports automated updates for Git Submodules via the git-submodules manager, which is currently in beta and must be explicitly enabled in the configuration.",
      "matchManagers": ["git-submodules"],
      "automerge": true
    },
    {
      "description": "Group openmcp-project/build submodule and workflow updates",
      "matchDepNames": [
        "hack/common",
        "openmcp-project/build"
      ],
      "groupName": "openmcp-project/build",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group all openmcp-project Go dependencies into one PR",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/openmcp-project//"
      ],
      "groupName": "openmcp-project Go dependencies",
      "groupSlug": "openmcp-go-deps",
      "minimumReleaseAge": "0 days"
    }
  ]
}
